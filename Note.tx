{/* Form Section */}
        <div className='bg-white shadow-lg rounded-lg p-5 mt-12 flex flex-col md:flex-row gap-4 items-center justify-between max-w-5xl mx-auto' data-aos="fade-up" data-aos-delay="400">

            {/* Location */}
            <div className='flex items-center gap-2 w-full md:w-auto'>
                <input type="text" placeholder="Choose Your Location" className='outline-none border-b w-full md:w-48 py-2 text-sm'/>
                <FaLocationArrow className='text-blue-600' />
            </div>

            {/* Pickup date  */}
            <div className='flex items-center gap-2 w-full md:w-auto'>
                <input type="date" className='outline-none border-b w-full md:w-36 py-2 text-sm' />
            </div>

            {/* Return date */}
            <div className='flex items-center gap-2 w-full md:w-auto'>
                <input type="date" className='outline-none border-b w-full md:w-36 py-2 text-sm'/>
            </div>

            {/* Book button */}
            <Button title="Book Your Ride" hover={false}/>

        </div>